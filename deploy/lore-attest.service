[Unit]
Description=Lore daily provider attestation evidence
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=lore
Group=lore
WorkingDirectory=/opt/lore
EnvironmentFile=/opt/lore/deploy/secrets/attestation.env
Environment=LORE_STORAGE_CLI=/usr/local/bin/lore-storage-client
ExecStart=/opt/lore/shared/.venv/bin/python /opt/lore/deploy/attest.py --db /opt/lore/deploy/state/gateway/gateway.sqlite3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/lore/deploy/state
UMask=0077
TimeoutStartSec=30min
